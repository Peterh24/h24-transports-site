# URL canonique du site (utilisée pour le SEO : sitemap, Open Graph, robots).
NEXT_PUBLIC_SITE_URL=https://h24transports.com

# --- Formulaire de contact ---
# L'envoi est BRANCHÉ : la Server Action POST vers l'API historique de H24,
# la même que celle qu'utilisait le site Angular. Aucune variable n'est
# nécessaire en temps normal — la valeur par défaut suffit.
# Ne renseigner CONTACT_API_URL que si le back déménage.
# CONTACT_API_URL=https://api.h24transports.com/api/send-email
